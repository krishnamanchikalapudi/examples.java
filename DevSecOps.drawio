        <mxCell id="i-o91WvaJZhET3LJYCC8-21" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;[PROTECT]&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;Automated security testing in the CI pipeline&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;* Generate RA &amp;amp; PIA automatically&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;* Static Application Security Testing (SAST)&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;* Security function tests (i.e. built internally)&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;* FOSS Auditing &amp;amp; CVE scan&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;* OWASP Top 10 Scanning&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;* Vulnerabilities mitigation (manual)&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;* Security patches (auto installation)&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;* Update privacy/security/Hardening guidelines&lt;/div&gt;" vertex="1">
